# DeepSeek API key (secure server-side only). Copy this file to .env and fill in.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional GitHub proxy if the GitHub API is unroutable in your environment
# GITHUB_BASE_URL=https://api.github.com
# GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com